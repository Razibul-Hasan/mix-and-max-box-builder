# ---------------------------------------------------------------
# Secrets and credentials: never commit these. The repo is public.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
auth.json
.npmrc
.netrc
.htpasswd
wp-config.php
wp-config-local.php
local-config.php
/tools/native-tests/wp-tests-config.local.php
/.svn-credentials
*.secret
*.secrets

# Database dumps and site exports can hold customer data.
*.sql
*.sql.gz
*.sqlite
*.db
*.wpress

# ---------------------------------------------------------------
# Dependencies and build output: rebuilt from the lockfiles.
# ---------------------------------------------------------------
/node_modules/
/vendor/
/build/
/.wordpress-org/
/coverage/

# Release archives and the SVN checkout used to deploy to WordPress.org.
*.zip
*.tar.gz
/svn/
/release/
/dist/

# ---------------------------------------------------------------
# Tool caches and local overrides
# ---------------------------------------------------------------
/.wp-env.override.json
/.phpunit.result.cache
/.phpunit.cache/
/.phpcs-cache
.eslintcache
.stylelintcache
*.tsbuildinfo
.cache/

# Personal Claude Code files. The shared agents and skills stay tracked.
/.claude/settings.local.json
/.claude/memory/
/.claude/projects/
/.claude/todos/
/.claude/*.log
/CLAUDE.local.md

# ---------------------------------------------------------------
# Logs and scratch files
# ---------------------------------------------------------------
*.log
npm-debug.log*
debug.log
/tmp/
/scratch/
*.bak
*.orig
*.rej
*.swp
*~

# ---------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------
/.vscode/*
!/.vscode/extensions.json
/.idea/
*.code-workspace
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
